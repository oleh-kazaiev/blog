# Development environment configuration
# Complete environment file for development
# Copy this file to .env in the same folder

# Database settings
POSTGRES_DB=blog
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django settings
DEBUG=True
SECRET_KEY=your_secret_key
ALLOWED_HOSTS=localhost 127.0.0.1 backend api.localhost blog.example.com api-blog.example.com

# Security settings
SECURE_SSL_REDIRECT=False
ENABLE_HSTS=False
ENABLE_SECURE_COOKIES=False
USE_PROXY_SSL_HEADER=True

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:3051 http://localhost:8000
CSRF_TRUSTED_ORIGINS=https://example.com,https://blog.example.com,https://api-blog.example.com

# Domain Configuration (Traefik routing)
FRONTEND_DOMAIN=blog.example.com
BACKEND_DOMAIN=api-blog.example.com
S3_DOMAIN=localstack-blog.example.com
FRONTEND_API_BASE=https://api-blog.example.com/api

# Celery settings
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_CONCURRENCY=2
CELERY_HIGH_CONCURRENCY=1
CELERY_BEAT_SCHEDULE_FILENAME=/var/lib/celery/celerybeat-schedule

# Resource settings
DB_CONN_MAX_AGE=600

# AWS S3 / LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_STORAGE_BUCKET_NAME=blog-local-media
AWS_S3_ENDPOINT_URL=http://localstack:4566
AWS_S3_REGION_NAME=us-east-1
AWS_S3_FORCE_PATH_STYLE=True

# Stripe / LocalStripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_API_BASE=http://stripelocal:8420
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_SUCCESS_URL=https://example.com/success
STRIPE_CANCEL_URL=https://example.com/cancel
LOCALSTRIPE_HOST=0.0.0.0
LOCALSTRIPE_PORT=8420
STRIPE_WEBHOOK_ENDPOINT=http://backend:8000/api/stripe/webhook/

# Subscription plan configuration
SUBSCRIPTION_PLAN_CURRENCY=usd
STRIPE_PLAN_DAY_ID=plan_blog_day
STRIPE_PLAN_WEEK_ID=plan_blog_week
STRIPE_PLAN_MONTH_ID=plan_blog_month

# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=payment-service
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
KAFKA_TOPIC_PAYMENTS_REQUEST=payments.request
KAFKA_TOPIC_PAYMENTS_COMPLETED=payments.completed
KAFKA_TOPIC_PAYMENTS_CANCELLED=payments.cancelled
KAFKA_TOPIC_SUBSCRIPTIONS_REQUEST=subscriptions.request
KAFKA_TOPIC_SUBSCRIPTIONS_COMPLETED=subscriptions.completed
KAFKA_TOPIC_SUBSCRIPTIONS_CANCELLED=subscriptions.cancelled
PAYMENT_EVENTS_CONSUMER_GROUP=payment-events-consumer

# Elasticsearch settings
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX_POSTS=blog_posts
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Email settings 
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com

# LocalStack settings
LOCALSTACK_SERVICES=s3
LOCALSTACK_DEBUG=1
