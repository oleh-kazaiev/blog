[flake8]
max-line-length = 120
; Ignored error codes:
; W503: Line break before binary operator
; D100: Missing docstring in public module
; D104: Missing docstring in public package
; D200: One-line docstring should fit on one line
; D400: First line should end with a period
; I201: Missing newline between import groups
; I202: Additional newline in a group of imports (conflicts with Django setup pattern)
; R504: Unnecessary variable assignment before return statement
; DJ01: Avoid using null=True on string-based fields
; S106: Possible hardcoded password
; G004: Logging statement uses f-string
extend-ignore = W503, D100, D104, D200, D400, I100, I101, I201, I202, R504, DJ01, S106, G004
; Import order configuration
import-order-style = google
application-import-names = backend,api,users,blog,payments,kafka_infra,main
exclude =
    .git,
    __pycache__,
    .venv,
    node_modules,
    frontend,
    data,
    logs,
    migrations,
per-file-ignores =
    __init__.py:F401
; import-order-style disabled due to plugin incompatibility in environment
; application-import-names disabled as well
inline-quotes = '
multiline-quotes = '
docstring-quotes = """
avoid-escape = true
max-line-complexity = 18
