[flake8]
max-line-length = 120
extend-ignore = E203, W503, D100, D101, D102, D103, D104, D105, D106, D200, D205, D400, I100, I201, W391, R504, DJ01, G004, S106
exclude =
    .git,
    __pycache__,
    .venv,
    node_modules,
    data,
    logs,
    migrations,
per-file-ignores =
    __init__.py:F401
inline-quotes = '
multiline-quotes = '
docstring-quotes = """
avoid-escape = true
max-line-complexity = 18
