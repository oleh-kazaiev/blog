# Reduce build context and avoid invalid file requests
# VCS and editor
.git
.gitignore
.vscode/
.idea/

# Python cache and venvs
**/__pycache__/
**/*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Local data and logs (mounted at runtime, not needed in image)
data/**
logs/**
**/*.log

# Docker
.dockerignore
